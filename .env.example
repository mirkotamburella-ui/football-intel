# Copia in .env (NON committare .env: è già in .gitignore) e compila solo ciò che ti serve.
# Senza chiavi il sistema usa solo le fonti pubbliche ESPN (calendari, risultati,
# classifiche, H2H, quote DraftKings/Bet365 esposte da ESPN) e dichiara mancanti
# i dati che richiedono provider a pagamento (xG, infortuni, mercati extra).

# The Odds API (https://the-odds-api.com) – quote multi-bookmaker (regione EU):
# 1X2, Over/Under su più linee, Goal/No Goal, Draw No Bet, Doppia chance.
ODDS_API_KEY=
ODDS_API_REGIONS=eu
# Tetto di crediti da consumare per singolo run (il piano free ne dà 500/mese)
ODDS_API_MAX_CREDITS_PER_RUN=40

# API-Football v3 (https://www.api-football.com) – infortuni/squalifiche e xG.
API_FOOTBALL_KEY=
# Tetto di richieste per run (il piano free ne dà 100/giorno)
API_FOOTBALL_MAX_REQUESTS_PER_RUN=60

# Parametri del sistema
STAKE_EUR=10
TIMEZONE=Europe/Rome
# Bookmaker su cui la quota è considerata "giocabile" (la migliore tra questi).
# Verifica tu che siano autorizzati ADM in Italia. DraftKings (via ESPN) opera solo
# negli USA: serve per il consenso di mercato, non come quota giocabile.
PREFERRED_BOOKMAKERS=bet365,williamhill,unibet_eu,betfair_ex_eu,sport888,betsson,leovegas
REQUIRE_PREFERRED_BOOKMAKER=true
MIN_SELECTION_SCORE=60
MIN_EV=0.0
MIN_LEG_ODDS=1.20
MAX_ODDS_AGE_MINUTES=90
MAX_MATCHES=0

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8365
# Se impostato, serve per avviare un'analisi dal telefono (POST /api/run)
DASHBOARD_TOKEN=
